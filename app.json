{
  "expo": {
    "name": "Fitzo",
    "slug": "fitzo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitzo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "package": "com.fitzo.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      [
        "react-native-radar",
        {
          "iosNSLocationWhenInUseUsageDescription": "Tu ubicación es necesaria para detectar cuándo entras al gimnasio.",
          "iosNSLocationAlwaysAndWhenInUseUsageDescription": "Tu ubicación es necesaria para detectar tu entrada al gimnasio en segundo plano.",
          "iosBackgroundMode": true,
          "androidBackgroundPermission": true,
          "androidFineLocationPermission": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f7b8417-7eec-4ee9-a4b2-f934542c75dd"
      }
    }
  }
}